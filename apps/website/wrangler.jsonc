{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rank-tracker",
  // Keep current with Cloudflare's recommended floor for Start + Workers.
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  // Prod only on the custom domain — no public *.workers.dev hostname.
  "workers_dev": false,
  // Serve prerendered index.html for client navigations; Worker still handles
  // non-asset requests (e.g. server functions) when no static file matches.
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "routes": [
    {
      "pattern": "rank.rtabulov.dev",
      "custom_domain": true,
    },
  ],
}
