{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Rank Tracker Companion",
  "version": "0.1.0",
  "identifier": "com.ranktracker.companion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev:vite",
    "beforeBuildCommand": "pnpm build:vite"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rank Tracker Companion",
        "width": 420,
        "height": 320,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/THIRD_PARTY_NOTICES.txt", "resources/tshark"],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
